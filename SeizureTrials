const symbol = { positive: '+', negative: '−', neutral: '/' }; const statusText = { positive: 'positive', negative: 'negative', neutral: 'neutral / equivocal' };
function escapeHTML(s){ return String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function normalize(s){ return String(s || '').toLowerCase().replace(/[–—−]/g,'-').replace(/[^a-z0-9+.#/\-\s]/g,' ').replace(/\s+/g,' ').trim(); }
function expandedQuery(q){ let base = normalize(q); if (!base) return ''; let extra=[]; Object.entries(aliases).forEach(([k,v]) => { if (base.includes(normalize(k))) extra.push(v); }); return normalize([base, ...extra].join(' ')); }
function haystack(t){ return normalize([t.trial,t.topic,t.subtopic,t.included,t.excluded,t.summary,t.status,t.data,t.limitations,t.takeaway,t.tags].join(' ')); }
function matchesQuery(t,q){
  const base = normalize(q);
  if(!base) return true;
  const hs = haystack(t);
  const baseTokens = base.split(' ').filter(tok => tok.length > 1);
  if(baseTokens.length && baseTokens.every(tok => hs.includes(tok))) return true;
  const eq = expandedQuery(q);
  const tokens = eq.split(' ').filter(tok => tok.length > 2);
  return tokens.some(tok => hs.includes(tok));
}
function subtopicsFor(topic){ let arr = trials.filter(t => topic === 'All topics' || t.topic === topic).map(t=>t.subtopic); return ['All subtopics', ...Array.from(new Set(arr))]; }
function renderTopics(){ const all=['All topics',...topics]; topicButtons.innerHTML = all.map(tp => `<button type="button" class="topic-btn ${state.topic===tp?'active':''}" data-topic="${escapeHTML(tp)}">${escapeHTML(tp)}</button>`).join(''); topicButtons.querySelectorAll('button').forEach(btn=>btn.addEventListener('click',()=>{ state.topic=btn.dataset.topic; state.subtopic='All subtopics'; renderSubtopics(); render(); })); }
function renderSubtopics(){ const opts = subtopicsFor(state.topic); subtopicSelect.innerHTML = opts.map(st => `<option value="${escapeHTML(st)}" ${state.subtopic===st?'selected':''}>${escapeHTML(st)}</option>`).join(''); }
function filtered(){
  const hasQuery = normalize(state.q).length > 0;
  return trials.filter(t =>
    (hasQuery || state.topic==='All topics'||t.topic===state.topic) &&
    (hasQuery || state.subtopic==='All subtopics'||t.subtopic===state.subtopic) &&
    (state.result==='all'||t.status===state.result) &&
    matchesQuery(t,state.q)
