function card(t){ const s = symbol[t.status]; const statusClass=t.status; return `<details class="trial-card" ${state.expanded?'open':''}><summary><div class="card-top"><div><h2 class="trial-name">${escapeHTML(t.trial)}</h2><div class="card-chips"><span class="tag subtopic">${escapeHTML(t.topic)}</span><span class="tag subtopic">${escapeHTML(t.subtopic)}</span><span class="tag result-${statusClass}">${s} ${escapeHTML(statusText[t.status])}</span></div><p class="summary-text">${escapeHTML(t.summary)}</p><div class="expand-hint">Click to expand clinical details</div></div><span class="status-badge ${statusClass}">${s}</span></div></summary><div class="card-body"><div class="clinical-grid"><div class="criterion"><div class="criterion-title">Included population</div><p>${escapeHTML(t.included)}</p></div><div class="criterion"><div class="criterion-title">Excluded / not included</div><p>${escapeHTML(t.excluded)}</p></div><div class="criterion"><div class="criterion-title">Trial results / data</div><p>${escapeHTML(t.data)}</p></div><div class="criterion"><div class="criterion-title">Limitations / applicability</div><p>${escapeHTML(t.limitations)}</p></div><div class="criterion wide"><div class="criterion-title">Clinical takeaway</div><p>${escapeHTML(t.takeaway)}</p></div></div></div></details>`; }
function renderCards(rows){ cards.innerHTML = rows.length ? rows.map(card).join('') : `<div class="empty">No trials match the current filters. Try a broader topic or search alias.</div>`; }
function renderTable(rows){ tableBody.innerHTML = rows.map(t => `<tr><td>${escapeHTML(t.trial)}</td><td>${escapeHTML(t.included)}</td><td>${escapeHTML(t.excluded)}</td><td>${escapeHTML(t.summary)}</td><td class="result-cell"><span class="mark ${t.status}">${symbol[t.status]}</span></td></tr>`).join(''); }
