const topics = ["Acute seizures / status epilepticus", "New diagnosis / first seizure / ASM strategy", "Generalized epilepsy / absence / myoclonic", "Focal epilepsy / adjunctive ASM trials", "Developmental epileptic encephalopathies / rare epilepsies", "Neonatal / infantile / pediatric epilepsy", "Surgery / neuromodulation / diet", "Medication-specific ASM evidence index"];
let state = { topic: 'All topics', subtopic: 'All subtopics', result: 'all', q: '', view: 'cards', expanded: false };
const topicButtons = document.getElementById('topicButtons'); const subtopicSelect = document.getElementById('subtopicSelect'); const searchInput = document.getElementById('searchInput'); const cards = document.getElementById('cards'); const tableBody = document.getElementById('tableBody'); const tableWrap = document.getElementById('tableWrap'); const stats = document.getElementById('stats');
